# --- LLM (choose one) ---
# Gemini key (free): https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# free tier: 3.5 Flash-Lite = 15 req/min, 500/day (2.5 Flash = only 20/day)
GEMINI_MODEL=gemini-3.5-flash-lite
# requests/minute the bot allows itself (Flash-Lite free: 15, Flash free: 5). 0 = no limit (paid tier)
GEMINI_RPM=14

# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

PORT=3000
# public https address of this server (ngrok/cloudflared) — needed to send menu images to WhatsApp
PUBLIC_BASE_URL=
# demo: accept orders even when the pizzeria is closed. Set false for real use.
DEMO_IGNORE_HOURS=true

# --- Storage (see src/storage.js) ---
# default: files in data/runtime (fine on your computer / a server with a permanent disk).
# free hosts (Render etc.) wipe the disk on restart → use a free Upstash Redis database instead:
# https://console.upstash.com → Create Database → REST API → copy URL + TOKEN. Setting them switches storage automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# how long conversation transcripts are kept
CONVERSATION_RETENTION_DAYS=90

# --- Admin password for /monitor, logs, conversations and orders (leave empty only on your own computer) ---
ADMIN_PASSWORD=
# read-only key for reading logs/conversations remotely (scripts/remote.js, or give it to Claude). Change it to revoke.
LOGS_TOKEN=
# where scripts/remote.js reads from (your deployed server)
PAPIDO_URL=

# --- WhatsApp via Meta Cloud API (after business verification) ---
META_VERIFY_TOKEN=choose-any-random-string
# permanent System User token
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# --- Kitchen notifications (optional, see src/kitchen.js) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_KITCHEN_CHAT_ID=

# --- Logs & monitoring (see README) ---
# console detail: debug | info | warn | error | silent   (files always get everything)
LOG_CONSOLE=info
# masked = phone numbers shortened in logs (972***233); full = keep as is
LOG_PII=masked
LOG_RETENTION_DAYS=14
